                    create_control(
                        hwnd,
                        "BUTTON",
                        "Sempre no topo",
                        BS_AUTOCHECKBOX,
                        22,
                        286,
                        150,
                        26,
                        ID_ALWAYS_ON_TOP,
                        instance,
                    )
                };

                let start_button = unsafe {
                    create_control(
