    enum Mode {
        Lens,
        Fixed,
        Docked,
    }

    struct AppState {
        main_hwnd: Hwnd,
        host_hwnd: Hwnd,
        mag_hwnd: Hwnd,
        zoom_label: Hwnd,
        area_label: Hwnd,
        start_button: Hwnd,
        lens_radio: Hwnd,
        fixed_radio: Hwnd,
        docked_radio: Hwnd,
        circle_checkbox: Hwnd,
        topmost_checkbox: Hwnd,
        status_label: Hwnd,
        zoom: f32,
        running: bool,
        mode: Mode,
        circle: bool,
        always_on_top: bool,
        lens_width: i32,
        lens_height: i32,
        dock_height: i32,
        bg_brush: Hbrush,
        panel_brush: Hbrush,
        ui_font: Hfont,
        title_font: Hfont,
        button_font: Hfont,
        last_lens_x: i32,
        last_lens_y: i32,
        last_source: Rect,
        has_last_source: bool,
    }

    impl Default for AppState {
        fn default() -> Self {
            Self {
                main_hwnd: 0,
                host_hwnd: 0,
                mag_hwnd: 0,
                zoom_label: 0,
                area_label: 0,
                start_button: 0,
                lens_radio: 0,
                fixed_radio: 0,
                docked_radio: 0,
                circle_checkbox: 0,
                topmost_checkbox: 0,
                status_label: 0,
                zoom: 2.0,
                running: false,
                mode: Mode::Lens,
                circle: false,
                always_on_top: true,
                lens_width: 560,
                lens_height: 360,
                dock_height: 240,
                bg_brush: 0,
                panel_brush: 0,
                ui_font: 0,
                title_font: 0,
                button_font: 0,
                last_lens_x: i32::MIN,
                last_lens_y: i32::MIN,
                last_source: Rect::default(),
                has_last_source: false,
            }
        }
    }

    static STATE: OnceLock<Mutex<AppState>> = OnceLock::new();

    fn state() -> &'static Mutex<AppState> {
        STATE.get_or_init(|| Mutex::new(AppState::default()))
    }

    fn wide(value: &str) -> Vec<u16> {
        value.encode_utf16().chain(std::iter::once(0)).collect()
    }

    fn loword(value: usize) -> usize {
        value & 0xFFFF
    }

    unsafe fn create_control(
        parent: Hwnd,
        class_name: &str,
        text: &str,
        style: Dword,
        x: i32,
        y: i32,
        width: i32,
        height: i32,
        id: usize,
        instance: Hinstance,
    ) -> Hwnd {
        let class = wide(class_name);
        let label = wide(text);
        let control = unsafe {
            CreateWindowExW(
                0,
                class.as_ptr(),
                label.as_ptr(),
                WS_CHILD | WS_VISIBLE | style,
                x,
                y,
                width,
                height,
                parent,
                id as Hmenu,
                instance,
                null_mut(),
            )
        };

        if control != 0 {
            let ui_font = state().lock().unwrap().ui_font;
            if ui_font != 0 {
                unsafe { SendMessageW(control, WM_SETFONT, ui_font as Wparam, TRUE as Lparam) };
            }

            if class_name == "BUTTON" && (style & BS_OWNERDRAW) == 0 {
                let dark_theme = wide("DarkMode_Explorer");
                unsafe { SetWindowTheme(control, dark_theme.as_ptr(), null()) };
            }
        }

        control
    }

    unsafe fn draw_owner_control(draw: *const DrawItemStruct) -> Lresult {
        if draw.is_null() {
            return 0;
        }

        let draw = unsafe { &*draw };
        let id = draw.ctl_id as usize;
        let mut rect = draw.rc_item;
        let pressed = (draw.item_state & ODS_SELECTED) != 0;
        let focused = (draw.item_state & ODS_FOCUS) != 0;
        let disabled = (draw.item_state & ODS_DISABLED) != 0;
        let (ui_font, button_font, mode, circle, always_on_top, running) = {
            let guard = state().lock().unwrap();
            (
                guard.ui_font,
                guard.button_font,
                guard.mode,
                guard.circle,
                guard.always_on_top,
                guard.running,
            )
        };

        if id == ID_MODE_PANEL || id == ID_SETTINGS_PANEL {
            let brush = unsafe { CreateSolidBrush(COLOR_PANEL) };
            let pen = unsafe { CreatePen(PS_SOLID, 1, COLOR_BORDER) };
            let old_brush = unsafe { SelectObject(draw.hdc, brush as Hgdiobj) };
            let old_pen = unsafe { SelectObject(draw.hdc, pen) };

            unsafe {
                RoundRect(
                    draw.hdc,
                    rect.left,
                    rect.top,
                    rect.right - 1,
                    rect.bottom - 1,
                    16,
                    16,
                );
                SelectObject(draw.hdc, old_brush);
                SelectObject(draw.hdc, old_pen);
                DeleteObject(brush as Hgdiobj);
                DeleteObject(pen);
            }

            let label = wide(if id == ID_MODE_PANEL {
                "Modo de exibição"
            } else {
                "Ampliação"
            });
            let mut label_rect = Rect {
                left: rect.left + 16,
                top: rect.top + 10,
                right: rect.right - 16,
                bottom: rect.top + 34,
            };

            unsafe {
                SetBkMode(draw.hdc, TRANSPARENT);
                SetTextColor(draw.hdc, COLOR_MUTED);
                if ui_font != 0 {
                    SelectObject(draw.hdc, ui_font as Hgdiobj);
                }
                DrawTextW(
                    draw.hdc,
                    label.as_ptr(),
                    -1,
                    &mut label_rect,
                    DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS,
                );
            }

            return TRUE as Lresult;
        }

        let selected = match id {
            ID_MODE_LENS => mode == Mode::Lens,
            ID_MODE_FIXED => mode == Mode::Fixed,
            ID_MODE_DOCKED => mode == Mode::Docked,
            ID_SHAPE_CIRCLE => circle,
            ID_ALWAYS_ON_TOP => always_on_top,
            _ => false,
        };

        let (fill, border) = match id {
            ID_START_STOP => {
                if running {
                    (
                        if pressed { COLOR_DANGER_DOWN } else { COLOR_DANGER },
                        if focused { COLOR_BORDER_FOCUS } else { COLOR_DANGER },
                    )
                } else {
                    (
                        if pressed { COLOR_PRIMARY_DOWN } else { COLOR_PRIMARY },
                        if focused { COLOR_BORDER_FOCUS } else { COLOR_PRIMARY },
                    )
                }
            },
            ID_EXIT => (
                if pressed { COLOR_DANGER_DOWN } else { COLOR_BG },
                if focused { COLOR_BORDER_FOCUS } else { COLOR_BG },
            ),
            ID_MODE_LENS | ID_MODE_FIXED | ID_MODE_DOCKED
            | ID_SHAPE_CIRCLE | ID_ALWAYS_ON_TOP => (
                if selected {
                    if pressed { COLOR_BUTTON_PRESSED } else { COLOR_SELECTED }
                } else if pressed {
                    COLOR_BUTTON_PRESSED
                } else {
                    COLOR_BUTTON
                },
                if selected || focused { COLOR_BORDER_FOCUS } else { COLOR_BORDER },
            ),
            ID_MINIMIZE => (
                if pressed { COLOR_BUTTON_PRESSED } else { COLOR_BG },
                if focused { COLOR_BORDER_FOCUS } else { COLOR_BG },
            ),
            _ => (
                if pressed { COLOR_BUTTON_PRESSED } else { COLOR_BUTTON },
                if focused { COLOR_BORDER_FOCUS } else { COLOR_BORDER },
            ),
        };

        let fill = if disabled { COLOR_PANEL } else { fill };
        let brush = unsafe { CreateSolidBrush(fill) };
        let pen = unsafe { CreatePen(PS_SOLID, if focused { 2 } else { 1 }, border) };
        let old_brush = unsafe { SelectObject(draw.hdc, brush as Hgdiobj) };
        let old_pen = unsafe { SelectObject(draw.hdc, pen) };

        unsafe {
            RoundRect(
                draw.hdc,
                rect.left + 1,
                rect.top + 1,
                rect.right - 1,
                rect.bottom - 1,
                14,
                14,
            );
            SelectObject(draw.hdc, old_brush);
            SelectObject(draw.hdc, old_pen);
            DeleteObject(brush as Hgdiobj);
            DeleteObject(pen);
        }

        let text_len = unsafe { GetWindowTextLengthW(draw.hwnd_item) };
        let mut text = vec![0u16; (text_len.max(0) + 1) as usize];
        unsafe { GetWindowTextW(draw.hwnd_item, text.as_mut_ptr(), text.len() as i32) };

        if pressed {
            rect.top += 1;
            rect.bottom += 1;
        }

        unsafe {
            SetBkMode(draw.hdc, TRANSPARENT);
            SetTextColor(
                draw.hdc,
                if disabled { COLOR_MUTED } else { COLOR_TEXT },
            );
            if button_font != 0 {
                SelectObject(draw.hdc, button_font as Hgdiobj);
            }
            DrawTextW(
                draw.hdc,
                text.as_ptr(),
                -1,
                &mut rect,
                DT_CENTER | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS,
            );
        }

        TRUE as Lresult
    }

    unsafe fn update_ui_labels() {
        // Fazemos apenas um snapshot dos handles/valores. Nenhuma chamada Win32
        // acontece enquanto o Mutex estiver bloqueado, evitando reentrada/deadlock.
        let (
            zoom_label,
            area_label,
            start_button,
            lens_radio,
            fixed_radio,
            docked_radio,
            circle_checkbox,
            topmost_checkbox,
            status_label,
            main_hwnd,
            zoom,
            lens_width,
            lens_height,
            dock_height,
            running,
            mode,
            circle,
            always_on_top,
        ) = {
            let guard = state().lock().unwrap();
